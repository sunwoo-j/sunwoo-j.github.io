---
layout: compress
---

{% assign icon_path = "/assets/img/app-icons" | relative_url %}

{
  "name": {{ site.social.name | jsonify }},
  "short_name": {{ site.social.name | jsonify }},
  "description": {{ site.description | jsonify }},
  "icons": [
    {
      "src": "{{ icon_path }}/orange-black-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "{{ icon_path }}/orange-black-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }],
  "start_url": "{{ '/index.html' | relative_url }}",
  "theme_color": "#090909",
  "background_color": "#ff5c1a",
  "display": "fullscreen"
}
